rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ======================================================================
    // 루트 크루(최초 개설 크루) — 최상위 컬렉션 그대로 사용
    // ======================================================================
    function crewExists() { return exists(/databases/$(db)/documents/meta/crew); }
    function crew() { return get(/databases/$(db)/documents/meta/crew).data; }
    function isOwner() { return signedIn() && crewExists() && crew().ownerUid == request.auth.uid; }
    function memExists() { return signedIn() && exists(/databases/$(db)/documents/members/$(request.auth.uid)); }
    function mem() { return get(/databases/$(db)/documents/members/$(request.auth.uid)).data; }
    function isActive() { return memExists() && mem().status == 'active'; }
    function isStaff() { return isOwner() || (isActive() && mem().role in ['owner', 'staff']); }

    // 크루 기본 정보 — 누구나 읽기, 최초 1회 생성자가 개설자, 이후 운영진 수정(개설자 변경 불가)
    match /meta/crew {
      allow read: if true;
      allow create: if signedIn() && !crewExists() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isStaff() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
    // 홈 대표 사진 등 공개 꾸미기 자료 — 누구나 읽기, 운영진 쓰기
    match /meta/{docId} {
      allow read: if true;
      allow write: if docId != 'crew' && isStaff();
    }
    // 주제곡(BGM) 조각 등 공개 미디어 — 누구나 읽기, 운영진 쓰기
    match /media/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 일정(등산·운동·친목) — 활동 크루원만 읽기. 등록: 활동 크루원(주관=본인) 또는 운영진. 수정: 주관자·운영진. 참석 체크: 활동 크루원 본인만 추가/제외
    match /hikes/{id} {
      allow read: if isActive() || isOwner();
      allow create: if isStaff() || (isActive() && request.resource.data.hostId == request.auth.uid);
      allow update: if isStaff()
        || (isActive() && resource.data.hostId == request.auth.uid)
        || (isActive() && changed().hasOnly(['photos']))
        || (isActive() && changed().hasOnly(['attendees', 'people', 'solo'])
            && resource.data.attendees.toSet().difference(request.resource.data.attendees.toSet()).hasOnly([request.auth.uid])
            && request.resource.data.attendees.toSet().difference(resource.data.attendees.toSet()).hasOnly([request.auth.uid])
            && resource.data.get('solo', []).toSet().difference(request.resource.data.get('solo', []).toSet()).hasOnly([request.auth.uid])
            && request.resource.data.get('solo', []).toSet().difference(resource.data.get('solo', []).toSet()).hasOnly([request.auth.uid]));
      allow delete: if isStaff();
    }

    // 크루원 — 활동 크루원만 명단 열람(본인 문서는 본인도). 가입 신청은 본인 문서를 '가입 대기·회원'으로만 생성
    match /members/{uid} {
      allow read: if isActive() || isOwner() || (signedIn() && request.auth.uid == uid);
      allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending' && request.resource.data.role == 'member')
        || (isOwner() && request.auth.uid == uid && request.resource.data.role == 'owner')
        || (isStaff() && request.resource.data.role == 'member');
      allow update: if isOwner()
        || (isStaff() && !('role' in changed()) && resource.data.role == 'member')
        || (signedIn() && request.auth.uid == uid && changed().hasOnly(['birth', 'gender', 'region', 'memo', 'car', 'rulesAck', 'rulesAckAt', 'loginCount', 'lastLoginAt']));
      allow delete: if isOwner() || (isStaff() && resource.data.role == 'member');
    }

    // 비밀번호(4자리) 보관 — 개설자만 열람. 본인 가입 시 생성, 운영진이 회원 추가 시 생성
    match /pins/{uid} {
      allow read: if isOwner();
      allow create: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow update, delete: if isOwner() || isStaff();
    }

    // 산행사진 공유 — 활동 크루원 열람·업로드(본인), 삭제는 본인 또는 운영진
    match /photos/{id} {
      allow read: if isStaff() || (isActive() && request.auth.uid in get(/databases/$(db)/documents/hikes/$(resource.data.hikeId)).data.attendees);
      allow create: if (isStaff() || (isActive() && request.auth.uid in get(/databases/$(db)/documents/hikes/$(request.resource.data.hikeId)).data.attendees)) && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isStaff() || (isActive() && resource.data.by == request.auth.uid);
    }

    // 일정별 대화(댓글) — 활동 크루원 읽기·작성(본인), 삭제는 본인 또는 운영진
    match /comments/{id} {
      allow read: if isActive() || isOwner();
      allow create: if isActive() && request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update: if isActive() && resource.data.by == request.auth.uid && changed().hasOnly(['text', 'edited', 'editedAt', 'del', 'delAt']) && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow delete: if isStaff();
    }

    // 개설자와 1:1 대화 — 당사자(with)와 개설자만. 회원끼리는 불가
    match /dms/{id} {
      allow read: if isOwner() || (isActive() && resource.data.with == request.auth.uid);
      allow create: if request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (isOwner() || (isActive() && request.resource.data.with == request.auth.uid));
      allow update: if (isOwner() || isActive()) && resource.data.by == request.auth.uid && changed().hasOnly(['text', 'edited', 'editedAt', 'del', 'delAt']);
      allow delete: if isOwner();
    }

    // 산 도감 덧붙임(크루 메모·직접 추가한 코스) — 활동 크루원만 읽기, 운영진만 쓰기
    match /mtx/{id} {
      allow read: if isActive() || isOwner();
      allow write: if isStaff();
    }

    // ======================================================================
    // 그 밖의 크루 — crews/{크루ID}/… 아래 같은 구조. 권한은 크루별로 완전히 분리
    // ======================================================================
    match /crews/{cid} {
      function cExists() { return exists(/databases/$(db)/documents/crews/$(cid)/meta/crew); }
      function cCrew() { return get(/databases/$(db)/documents/crews/$(cid)/meta/crew).data; }
      function cOwner() { return signedIn() && cExists() && cCrew().ownerUid == request.auth.uid; }
      function cMemExists() { return signedIn() && exists(/databases/$(db)/documents/crews/$(cid)/members/$(request.auth.uid)); }
      function cMem() { return get(/databases/$(db)/documents/crews/$(cid)/members/$(request.auth.uid)).data; }
      function cActive() { return cMemExists() && cMem().status == 'active'; }
      function cStaff() { return cOwner() || (cActive() && cMem().role in ['owner', 'staff']); }
      function validCid() { return cid.matches('^[a-z0-9][a-z0-9-]{2,19}$') && !(cid in ['new', 'start', 'admin', 'api', 'www', 'app', 'crews']); }

      match /meta/crew {
        allow read: if true;
        allow create: if signedIn() && validCid() && !cExists() && request.resource.data.ownerUid == request.auth.uid;
        allow update: if cStaff() && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if false;
      }
      match /meta/{docId} {
        allow read: if true;
        allow write: if docId != 'crew' && cStaff();
      }
      match /media/{id} {
        allow read: if true;
        allow write: if cStaff();
      }
      match /hikes/{id} {
        allow read: if cActive() || cOwner();
        allow create: if cStaff() || (cActive() && request.resource.data.hostId == request.auth.uid);
        allow update: if cStaff()
          || (cActive() && resource.data.hostId == request.auth.uid)
          || (cActive() && changed().hasOnly(['photos']))
          || (cActive() && changed().hasOnly(['attendees', 'people', 'solo'])
              && resource.data.attendees.toSet().difference(request.resource.data.attendees.toSet()).hasOnly([request.auth.uid])
              && request.resource.data.attendees.toSet().difference(resource.data.attendees.toSet()).hasOnly([request.auth.uid])
              && resource.data.get('solo', []).toSet().difference(request.resource.data.get('solo', []).toSet()).hasOnly([request.auth.uid])
              && request.resource.data.get('solo', []).toSet().difference(resource.data.get('solo', []).toSet()).hasOnly([request.auth.uid]));
        allow delete: if cStaff();
      }
      match /members/{uid} {
        allow read: if cActive() || cOwner() || (signedIn() && request.auth.uid == uid);
        allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending' && request.resource.data.role == 'member')
          || (cOwner() && request.auth.uid == uid && request.resource.data.role == 'owner')
          || (cStaff() && request.resource.data.role == 'member');
        allow update: if cOwner()
          || (cStaff() && !('role' in changed()) && resource.data.role == 'member')
          || (signedIn() && request.auth.uid == uid && changed().hasOnly(['birth', 'gender', 'region', 'memo', 'car', 'rulesAck', 'rulesAckAt', 'loginCount', 'lastLoginAt']));
        allow delete: if cOwner() || (cStaff() && resource.data.role == 'member');
      }
      match /pins/{uid} {
        allow read: if cOwner();
        allow create: if (signedIn() && request.auth.uid == uid) || cStaff();
        allow update, delete: if cOwner() || cStaff();
      }
      match /photos/{id} {
        allow read: if cStaff() || (cActive() && request.auth.uid in get(/databases/$(db)/documents/crews/$(cid)/hikes/$(resource.data.hikeId)).data.attendees);
        allow create: if (cStaff() || (cActive() && request.auth.uid in get(/databases/$(db)/documents/crews/$(cid)/hikes/$(request.resource.data.hikeId)).data.attendees)) && request.resource.data.by == request.auth.uid;
        allow update: if false;
        allow delete: if cStaff() || (cActive() && resource.data.by == request.auth.uid);
      }
      match /comments/{id} {
        allow read: if cActive() || cOwner();
        allow create: if cActive() && request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow update: if cActive() && resource.data.by == request.auth.uid && changed().hasOnly(['text', 'edited', 'editedAt', 'del', 'delAt']) && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if cStaff();
      }
      match /dms/{id} {
        allow read: if cOwner() || (cActive() && resource.data.with == request.auth.uid);
        allow create: if request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (cOwner() || (cActive() && request.resource.data.with == request.auth.uid));
        allow update: if (cOwner() || cActive()) && resource.data.by == request.auth.uid && changed().hasOnly(['text', 'edited', 'editedAt', 'del', 'delAt']);
        allow delete: if cOwner();
      }
      match /mtx/{id} {
        allow read: if cActive() || cOwner();
        allow write: if cStaff();
      }
    }
  }
}
